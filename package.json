{
  "name": "le-boss",
  "private": true,
  "version": "1.0.0",
  "description": "LE BOSS \u2014 un roguelite invers\u00e9 : vous \u00eates le boss final.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild scripts/balance-sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim.mjs --log-level=warning && node node_modules/.cache/sim.mjs",
    "android:patch": "node scripts/patch-android.mjs",
    "capacitor:sync:after": "node scripts/patch-android.mjs",
    "capacitor:add:after": "node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}